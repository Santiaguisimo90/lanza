# Copia este archivo a .env (en esta misma carpeta) y rellena. NUNCA lo subas a git.
LANZA_DOMAIN=lanza.inmobiliarioec.com
LANZA_IMAGE=ghcr.io/santiaguisimo90/lanza:latest

# Token del tunel (Cloudflare Zero Trust > Networks > Tunnels). Ver PENDIENTES_SANTIAGO.md
CLOUDFLARE_TUNNEL_TOKEN=

# Genera cada uno con:  openssl rand -base64 32   (o con el script preparar-windows.ps1)
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=
ENCRYPTION_KEY=

# Ponlo en true DESPUES de crear tu cuenta
DISABLE_REGISTRATION=false

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lanza-media
R2_PUBLIC_URL=
R2_BACKUP_BUCKET=lanza-backups

# Telegram (@iec_capitan_bot): aviso si falla el respaldo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redes (ver PENDIENTES_SANTIAGO.md)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
