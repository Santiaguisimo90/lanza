# Copia este archivo a .env en el VPS y rellena los valores. NUNCA lo subas a git.
LANZA_DOMAIN=lanza.inmobiliarioec.com
LANZA_IMAGE=ghcr.io/santiaguisimo90/lanza:latest

# Genera cada uno con: openssl rand -base64 32
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=
ENCRYPTION_KEY=

# Ponlo en true DESPUES de crear tu cuenta
DISABLE_REGISTRATION=false

# Cloudflare R2 (medios y respaldos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_BACKUP_BUCKET=

# Telegram (aviso si falla el respaldo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo opcional (resend). Si se deja vacio no se piden activaciones.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=

# Redes (ver PENDIENTES_SANTIAGO.md)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
